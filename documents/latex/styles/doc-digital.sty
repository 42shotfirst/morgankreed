% Pinpoint Digital Premium Style
% Dark-theme, screen-optimized styling mirroring getpinpoint.dev
% Circuit-board decorations, glass-morphism boxes, electric blue accent
% Version: 1.0
% Requires: LuaLaTeX or XeLaTeX for font support

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{doc-digital}[2026/03/01 Pinpoint Digital Premium]

% ============================================================================
% FONT CONFIGURATION
% ============================================================================

\RequirePackage{fontspec}

% Primary: Plus Jakarta Sans (matches getpinpoint.dev)
% Fallback chain: Inter > Source Sans Pro
\IfFontExistsTF{Plus Jakarta Sans}{%
    \setsansfont{Plus Jakarta Sans}[
        Numbers=Proportional,
        Ligatures=TeX,
    ]
}{%
    \IfFontExistsTF{Inter}{%
        \setsansfont{Inter}[Numbers=Proportional, Scale=0.95]
    }{%
        \setsansfont{Source Sans Pro}[Numbers=Proportional, Scale=0.95]
    }%
}

% Sans-serif as document default (digital-first)
\renewcommand{\familydefault}{\sfdefault}

% Monospace: JetBrains Mono (matches website code blocks)
\setmonofont{JetBrains Mono}[
    Scale=0.85,
    Contextuals=Alternate,
]

% Serif: reserved for special emphasis or pull quotes
\setmainfont{Source Serif 4}[
    Numbers=Proportional,
    Ligatures=TeX,
]

% Math support
\RequirePackage{mathtools}
\RequirePackage{unicode-math}
\setmathfont{TeX Gyre Termes Math}

% Microtypography
\RequirePackage{microtype}
\microtypesetup{
    protrusion=true,
    expansion=true,
    final=true,
}

% ============================================================================
% COLOR SCHEME — Pinpoint Digital Palette
% ============================================================================
%
% Derived from the getpinpoint.dev website CSS custom properties and
% Tailwind configuration. Optimized for dark backgrounds with high
% color saturation since this targets screens only.
%
% WCAG notes: All text colors meet AA contrast against PinBlack.
%   PinText on PinBlack:       ~13.2:1 (AAA)
%   PinTextMuted on PinBlack:  ~6.8:1  (AA)
%   PinBlue on PinBlack:       ~5.1:1  (AA)
%
% ============================================================================

\RequirePackage[dvipsnames]{xcolor}

% --- Core brand (from tailwind.config.ts) ---
\definecolor{PinBlack}{HTML}{0A0A0F}        % Page background
\definecolor{PinCard}{HTML}{111827}          % Card / elevated surface
\definecolor{PinSurface}{HTML}{1A1F2E}      % Raised surface / glass fill
\definecolor{PinNavy}{HTML}{1E3A5F}         % Secondary deep blue
\definecolor{PinBlue}{HTML}{3482EF}         % Primary accent (electric blue)
\definecolor{PinBlueDeep}{HTML}{2563EB}     % Interactive / button blue

% --- Text hierarchy ---
\definecolor{PinText}{HTML}{E2E8F0}         % Body text
\definecolor{PinTextBright}{HTML}{F0F4F8}   % Headings, emphasis
\definecolor{PinTextMuted}{HTML}{94A3B8}    % Captions, metadata
\definecolor{PinTextDim}{HTML}{64748B}      % Disabled, timestamps

% --- Status / semantic ---
\definecolor{PinSuccess}{HTML}{22C55E}      % Positive, complete (green-500)
\definecolor{PinWarning}{HTML}{EAB308}      % Caution, pending (yellow-500)
\definecolor{PinDanger}{HTML}{EF4444}       % Error, destructive

% --- Borders / structure ---
\definecolor{PinBorder}{HTML}{1F2937}       % Default border
\definecolor{PinBorderLight}{HTML}{374151}  % Emphasized border

% --- Semantic aliases (backward-compatible with doc-premium naming) ---
\colorlet{DocBlue}{PinBlue}
\colorlet{DocNavy}{PinNavy}
\colorlet{DocEmerald}{PinSuccess}
\colorlet{DocBrass}{PinWarning}
\colorlet{DocBurgundy}{PinDanger}
\colorlet{DocDark}{PinBlack}
\colorlet{DocMuted}{PinTextMuted}
\colorlet{DocLight}{PinCard}
\colorlet{DocBg}{PinBlack}
\colorlet{DocSuccess}{PinSuccess}
\colorlet{DocWarning}{PinWarning}
\colorlet{DocDanger}{PinDanger}

% ============================================================================
% PAGE LAYOUT AND DARK BACKGROUND
% ============================================================================

\RequirePackage{geometry}
\geometry{
    a4paper,
    top=28mm,
    bottom=28mm,
    left=25mm,
    right=25mm,
    headheight=22pt,
}

% Dark page background with light default text
\pagecolor{PinBlack}
\color{PinText}

% ============================================================================
% SPACING AND TYPOGRAPHY (Butterick, tuned for screen)
% ============================================================================

\RequirePackage{setspace}
\setstretch{1.35}  % Generous line height for screen legibility

\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt plus 2pt minus 1pt}

% Widow/orphan control
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=10000

% Hyphenation
\RequirePackage[english]{babel}
\tolerance=1000
\emergencystretch=1em
\hyphenpenalty=50

% Prevent orphaned headers
\RequirePackage{needspace}

% ============================================================================
% SECTION HEADINGS
% ============================================================================

\RequirePackage{titlesec}

% Section: electric blue with subtle rule underneath
\titleformat{\section}
    {\Large\bfseries\sffamily\color{PinBlue}}
    {\thesection}{1em}{}
    [\vspace{2pt}{\color{PinBorder}\titlerule[0.6pt]}]

% Subsection: bright white
\titleformat{\subsection}
    {\large\bfseries\sffamily\color{PinTextBright}}
    {\thesubsection}{1em}{}

% Subsubsection: muted
\titleformat{\subsubsection}
    {\normalsize\bfseries\sffamily\color{PinTextMuted}}
    {\thesubsubsection}{1em}{}

\titlespacing*{\section}{0pt}{24pt plus 4pt minus 2pt}{12pt plus 2pt minus 1pt}
\titlespacing*{\subsection}{0pt}{18pt plus 3pt minus 2pt}{8pt plus 2pt minus 1pt}
\titlespacing*{\subsubsection}{0pt}{12pt plus 2pt minus 1pt}{6pt plus 1pt}

% ============================================================================
% GLASS MORPHISM CALLOUT BOXES
% ============================================================================
%
% Simulates the website's glass-section component:
%   backdrop-blur, white/[0.08] border, translucent gradient fill,
%   subtle outer shadow, inset highlight along top edge.
%
% In LaTeX/tcolorbox we approximate this with:
%   - Dark translucent fill (PinSurface)
%   - Thin luminous border (PinBorderLight)
%   - Rounded corners (arc=6pt)
%   - Soft drop shadow
%   - Colored west-side accent stripe per semantic type
%
% ============================================================================

\RequirePackage[most]{tcolorbox}

% Base glass preset
\tcbset{
    glass/.style={
        enhanced,
        rounded corners,
        arc=6pt,
        boxrule=0.5pt,
        colframe=PinBorderLight,
        colback=PinSurface,
        coltext=PinText,
        top=10pt,
        bottom=10pt,
        left=14pt,
        right=14pt,
        fonttitle=\sffamily\bfseries,
        before skip=15pt,
        after skip=15pt,
        unbreakable,
        shadow={1pt}{-1pt}{0pt}{black!50},
    },
}

% Key Insight (blue accent)
\newtcolorbox{keyinsight}{
    glass,
    colframe=PinBlue!50,
    colback=PinBlue!6!PinBlack,
    title=Key Insight,
    colbacktitle=PinBlue!15!PinBlack,
    coltitle=PinBlue,
    borderline west={3pt}{0pt}{PinBlue},
}

% Business Value (green accent)
\newtcolorbox{businessvalue}{
    glass,
    colframe=PinSuccess!40,
    colback=PinSuccess!5!PinBlack,
    title=Business Value,
    colbacktitle=PinSuccess!12!PinBlack,
    coltitle=PinSuccess,
    borderline west={3pt}{0pt}{PinSuccess},
}

% Technical Detail (neutral accent)
\newtcolorbox{technicaldetail}{
    glass,
    colframe=PinBorderLight,
    colback=PinCard,
    title=Technical Detail,
    colbacktitle=PinBorderLight!20!PinBlack,
    coltitle=PinTextMuted,
    borderline west={3pt}{0pt}{PinTextMuted},
}

% Critical Point (amber accent)
\newtcolorbox{criticalpoint}{
    glass,
    colframe=PinWarning!40,
    colback=PinWarning!5!PinBlack,
    title=Critical Point,
    colbacktitle=PinWarning!12!PinBlack,
    coltitle=PinWarning,
    borderline west={3pt}{0pt}{PinWarning},
}

% Warning (red accent)
\newtcolorbox{warningbox}{
    glass,
    colframe=PinDanger!40,
    colback=PinDanger!5!PinBlack,
    title=Warning,
    colbacktitle=PinDanger!12!PinBlack,
    coltitle=PinDanger,
    borderline west={3pt}{0pt}{PinDanger},
}

% Plain callout (neutral glass)
\newtcolorbox{callout}{
    glass,
    colback=PinSurface,
    colframe=PinBorder,
}

% Note box (subtle blue border)
\newtcolorbox{notebox}{
    glass,
    colback=PinCard,
    colframe=PinBlue!20,
    boxrule=0.5pt,
}

