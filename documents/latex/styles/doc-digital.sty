% ============================================================================
% CIRCUIT BOARD BACKGROUND DECORATIONS
% ============================================================================
%
% Mirrors the SVG grid-lines, pulse-nodes, and flow-dots from the website's
% PageBackground component. Three density levels match the website:
%   \circuitlight   — sparse grid, few nodes (content pages)
%   \circuitmedium  — moderate density (section breaks)
%   \circuitfull    — dense grid with flow traces (title page)
%
% Each command draws into a tikzpicture with [remember picture, overlay]
% so it layers behind page content. Use at the start of a page or inside
% \AtBeginShipout for automatic placement.
%
% Performance note: TikZ overlays on every page can slow compilation.
% For long documents, apply circuit decorations only to select pages.
% ============================================================================

% --- Sparse circuit (content pages) ---
\newcommand{\circuitlight}{%
    \begin{tikzpicture}[remember picture, overlay]
        % Grid lines (6 each direction) — mix with PinBlack, not white
        \foreach \f in {0.15, 0.30, 0.45, 0.60, 0.75, 0.90} {
            \draw[PinBlue!15!PinBlack, line width=0.3pt]
                ($(current page.south west)!\f!(current page.north west)$) --
                ($(current page.south east)!\f!(current page.north east)$);
            \draw[PinBlue!15!PinBlack, line width=0.3pt]
                ($(current page.south west)!\f!(current page.south east)$) --
                ($(current page.north west)!\f!(current page.north east)$);
        }
        % Pulse nodes (sparse)
        \foreach \xf/\yf in {0.30/0.45, 0.60/0.75, 0.75/0.30} {
            \fill[PinBlue!30!PinBlack]
                ($(current page.south west) + (\xf\paperwidth, \yf\paperheight)$)
                circle (1.5pt);
        }
    \end{tikzpicture}%
}

% --- Medium circuit (section breaks) ---
\newcommand{\circuitmedium}{%
    \begin{tikzpicture}[remember picture, overlay]
        % Grid lines (8 each direction)
        \foreach \f in {0.10, 0.22, 0.34, 0.46, 0.58, 0.70, 0.82, 0.94} {
            \draw[PinBlue!18!PinBlack, line width=0.3pt]
                ($(current page.south west)!\f!(current page.north west)$) --
                ($(current page.south east)!\f!(current page.north east)$);
            \draw[PinBlue!18!PinBlack, line width=0.3pt]
                ($(current page.south west)!\f!(current page.south east)$) --
                ($(current page.north west)!\f!(current page.north east)$);
        }
        % Pulse nodes (medium)
        \foreach \xf/\yf in {0.22/0.34, 0.46/0.70, 0.70/0.46, 0.34/0.82, 0.82/0.22, 0.58/0.58} {
            \fill[PinBlue!35!PinBlack]
                ($(current page.south west) + (\xf\paperwidth, \yf\paperheight)$)
                circle (2pt);
        }
        % Single flow trace
        \draw[PinBlue!25!PinBlack, line width=0.5pt]
            ($(current page.south west) + (0.22\paperwidth, 0.34\paperheight)$)
            -- ++(25mm, 0) -- ++(0, 18mm) -- ++(30mm, 0);
    \end{tikzpicture}%
}

% --- Full circuit (title pages and dividers) ---
\newcommand{\circuitfull}{%
    \begin{tikzpicture}[remember picture, overlay]
        % Dense grid (12 each direction) — blue tinted against black
        \foreach \f in {0.06, 0.14, 0.22, 0.30, 0.38, 0.46, 0.54, 0.62, 0.70, 0.78, 0.86, 0.94} {
            \draw[PinBlue!20!PinBlack, line width=0.3pt]
                ($(current page.south west)!\f!(current page.north west) + (20mm, 0)$) --
                ($(current page.south east)!\f!(current page.north east) + (-20mm, 0)$);
            \draw[PinBlue!20!PinBlack, line width=0.3pt]
                ($(current page.south west)!\f!(current page.south east) + (0, 20mm)$) --
                ($(current page.north west)!\f!(current page.north east) + (0, -20mm)$);
        }
        % Pulse nodes (dense)
        \foreach \xf/\yf in {
            0.22/0.30, 0.46/0.70, 0.78/0.46, 0.30/0.86, 0.62/0.22,
            0.38/0.54, 0.86/0.62, 0.14/0.78, 0.54/0.38%
        } {
            \fill[PinBlue!40!PinBlack]
                ($(current page.south west) + (\xf\paperwidth, \yf\paperheight)$)
                circle (2.5pt);
        }
        % Flow traces (right-angle circuit paths)
        \draw[PinBlue!30!PinBlack, line width=0.5pt]
            ($(current page.south west) + (25mm, 40mm)$)
            -- ++(30mm, 0) -- ++(0, 20mm) -- ++(40mm, 0);
        \draw[PinBlue!30!PinBlack, line width=0.5pt]
            ($(current page.north east) + (-25mm, -50mm)$)
            -- ++(-25mm, 0) -- ++(0, -30mm) -- ++(-35mm, 0);
        \draw[PinBlue!30!PinBlack, line width=0.5pt]
            ($(current page.south east) + (-30mm, 60mm)$)
            -- ++(0, 25mm) -- ++(-40mm, 0) -- ++(0, 15mm);
        % Bottom mask — solid rectangle to fade out grid at page bottom
        \fill[PinBlack]
            (current page.south west) rectangle
            ($(current page.south east) + (0, 20mm)$);
    \end{tikzpicture}%
}

% ============================================================================
% TITLE PAGE
% ============================================================================
%
% Usage:
%   \digitaltitle[Subtitle text]{Document Title}{Author Name}{March 2026}
%
% Renders a full-page dark title with circuit-board background, central
% blue glow, and clean typographic hierarchy.
% ============================================================================

\newcommand{\digitaltitle}[4][]{%
    % #1 = optional subtitle
    % #2 = title
    % #3 = author
    % #4 = date
    \begin{titlepage}
        \circuitfull
        % Central glow rings
        \begin{tikzpicture}[remember picture, overlay]
            \fill[PinBlue, opacity=0.03]
                ($(current page.center) + (0, 1cm)$) circle (9cm);
            \fill[PinBlue, opacity=0.015]
                ($(current page.center) + (0, 1cm)$) circle (13cm);
        \end{tikzpicture}
        \vspace*{4cm}
        \begin{center}
            {\fontsize{36}{44}\selectfont\bfseries\sffamily%
             \textcolor{PinBlue}{#2}\par}
            \vspace{8mm}
            \ifx\\#1\\%
            \else
                {\Large\sffamily\textcolor{PinTextMuted}{#1}\par}
                \vspace{6mm}
            \fi
            {\color{PinBlue!35}\rule{8cm}{0.4pt}\par}
            \vspace{8mm}
            {\large\sffamily\textcolor{PinTextBright}{#3}\par}
            \vspace{4mm}
            {\sffamily\textcolor{PinTextDim}{#4}\par}
        \end{center}
    \end{titlepage}
    \setcounter{page}{1}%
}

% ============================================================================
% SECTION BREAK PAGE
% ============================================================================
%
% Usage: \sectionpage{Section Title}
%
% Full-page divider between major document sections. Draws the medium
% circuit background and centers the section title in electric blue.
% ============================================================================

\newcommand{\sectionpage}[1]{%
    \clearpage
    \thispagestyle{empty}
    \circuitmedium
    \begin{tikzpicture}[remember picture, overlay]
        \fill[PinBlue, opacity=0.025]
            (current page.center) circle (7cm);
    \end{tikzpicture}
    \vspace*{\fill}
    \begin{center}
        {\fontsize{28}{36}\selectfont\bfseries\sffamily%
         \textcolor{PinBlue}{#1}\par}
        \vspace{4mm}
        {\color{PinBlue!30}\rule{5cm}{0.4pt}\par}
    \end{center}
    \vspace*{\fill}
    \clearpage
}

% ============================================================================
% CODE LISTINGS (Dark Theme)
% ============================================================================
%
% Overrides default listings colors for dark backgrounds. If doc-code.sty
% is loaded alongside this package, these settings take precedence because
% doc-digital loads after doc-code in the preamble.
% ============================================================================

\RequirePackage{listings}

\lstset{
    basicstyle=\ttfamily\small\color{PinText},
    keywordstyle=\color{PinBlue}\bfseries,
    commentstyle=\color{PinTextDim}\itshape,
    stringstyle=\color{PinSuccess},
    backgroundcolor=\color{PinCard},
    frame=single,
    frameround=tttt,
    framesep=8pt,
    rulecolor=\color{PinBorder},
    breaklines=true,
    showstringspaces=false,
    numbers=left,
    numberstyle=\tiny\color{PinTextDim},
    xleftmargin=15pt,
    xrightmargin=5pt,
    captionpos=b,
    tabsize=4,
    keepspaces=true,
    columns=flexible,
}

% Inline code (dark chip)
\newcommand{\pincode}[1]{%
    \colorbox{PinCard}{\texttt{\textcolor{PinBlue}{#1}}}%
}

